{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/query.ts": {
      "includeFiles": "data/gold/**"
    },
    "api/chart.ts": {
      "includeFiles": "data/gold/**"
    },
    "api/products.ts": {
      "includeFiles": "data/{gold,meta}/**"
    },
    "api/trust.ts": {
      "includeFiles": "data/meta/**"
    },
    "api/runs.ts": {
      "includeFiles": "data/meta/**"
    },
    "api/lineage.ts": {
      "includeFiles": "data/meta/**"
    },
    "api/metrics.ts": {
      "includeFiles": "data/meta/**"
    }
  }
}
